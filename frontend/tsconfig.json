{
 "compilerOptions": {
  "jsx": "react-jsx",
  "target": "ES2020",
  "module": "ESNext",
  "moduleResolution": "bundler",
  "strict": false,
  "skipLibCheck": true,
  "types": [
   "vite/client"
  ],
  "allowImportingTsExtensions": true,
  "noEmit": true
 },
 "include": [
  "src"
 ],
 "exclude": [
  "src/**/*.test.ts"
 ]
}