JWT_SECRET=generate-a-random-string-of-at-least-32-chars
SUPER_ADMIN_EMAILS=you@example.com
DATABASE_URL=postgresql+psycopg://postgres:change-me@db:5432/sniper
# Not yet used (future phases): OPENAI_API_KEY, TELEGRAM_BOT_TOKEN, PAYPAL_CLIENT_ID, PAYPAL_SECRET, PAYPAL_WEBHOOK_ID
CORS_ORIGINS=https://your-frontend.vercel.app
APP_URL=https://your-frontend.vercel.app
# Email (password reset): SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASSWORD SMTP_FROM
# PayPal: PAYPAL_CLIENT_ID PAYPAL_SECRET PAYPAL_WEBHOOK_ID PAYPAL_PLAN_PRO PAYPAL_PLAN_VIP PAYPAL_BASE(=https://api-m.paypal.com for live)
# WhatsApp Cloud API: WHATSAPP_TOKEN WHATSAPP_PHONE_ID WHATSAPP_TEMPLATE(approved template for business-initiated msgs)

# Free-tier notes: no Redis, no OpenAI, no pgvector needed. Optional integrations stay disabled when unset.
# TELEGRAM_BOT_TOKEN TELEGRAM_WEBHOOK_SECRET
# Worker (in-process, free): WORKER_ENABLED=1 (set in Dockerfile). Optional Redis wake-up only: REDIS_URL (free tiers exist; jobs stay in the DB).
# OPTIONAL PAID features (OFF by default; also need the admin toggle in the Admin > Settings tab):
#   LLM extraction: OPENAI_API_KEY, LLM_MODEL (default gpt-4o-mini), OPENAI_BASE_URL
#   pgvector (Postgres only, e.g. Neon/Supabase free tier): USE_PGVECTOR=1 before running `alembic upgrade head`

# v3.1 (all optional, all free)
# WORKER_ENABLED=0 (API only) + run `python -m app.worker` as a separate service for multi-instance setups
# RLS_ENFORCE=1  (only with a non-owner DB role, see docs/SECURITY.md)
# SENTRY_DSN=    (optional; needs `pip install sentry-sdk`; self-hosted /api/admin/errors works without it)
# LOG_LEVEL=INFO
